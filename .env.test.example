# Test Environment Variables
# Copy this file to .env.test and add your actual API keys
# These keys are used for integration tests with real LLM providers

# OpenAI API Key (for gpt-4o-mini testing)
TEST_OPENAI_API_KEY=sk-...

# Google Gemini API Key (for gemini-1.5-flash testing)
TEST_GEMINI_API_KEY=AI...

# Grok API Key (for grok-4-1-fast-reasoning testing)
TEST_GROK_API_KEY=gsk_...

# Preplexcity API Key (for perplexity-ai testing)
TEST_PERPLEXITY_API_KEY=pk_...

# Test Configuration Flags
# Set to 'true' to use real LLM APIs in tests (will incur costs)
USE_REAL_LLM_APIS=false

# Set to 'true' to use mocked providers (default for unit tests)
USE_MOCK_LLM=true

# CI Environment
CI=false

