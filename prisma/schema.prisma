// Prisma Schema for Resume Builder
// Migrated from Drizzle ORM

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id Int @id @default(autoincrement())

  // Display label for this profile (user-provided, e.g. "Senior Engineer", "Career Changer")
  label String @default("Default Profile") @map("profile_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Header / Contact Info
  name     String
  email    String
  phone    String?
  location String?
  linkedin String?
  github   String?
  website  String?

  // Professional Summary
  summary String?

  // Skills (stored as JSON array)
  skillsJson String @default("[]") @map("skills_json")

  // Experience, Projects, Education, Certifications stored as JSON arrays
  experienceJson     String @default("[]") @map("experience_json")
  projectsJson       String @default("[]") @map("projects_json")
  educationJson      String @default("[]") @map("education_json")
  certificationsJson String @default("[]") @map("certifications_json")

  // Publications (optional)
  publicationsJson String? @map("publications_json")

  // Languages (optional)
  languagesJson String? @map("languages_json")

  // Volunteer work (optional)
  volunteerJson String? @map("volunteer_json")

  // Awards/Honors (optional)
  awardsJson String? @map("awards_json")

  jobs Job[]

  @@map("profiles")
}

model Company {
  id                    Int     @id @default(autoincrement())
  name                  String
  industry              String?
  description           String?
  marketPosition        String? @map("market_position")
  locationCity          String? @map("location_city")
  locationCountry       String? @map("location_country")
  officeLocationDetails String? @map("office_location_details")

  jobs Job[]

  @@map("companies")
}

model Contact {
  id                       Int      @id @default(autoincrement())
  recruiterName            String?  @map("recruiter_name")
  recruiterRole            String?  @map("recruiter_role")
  contactEmail             String?  @map("contact_email")
  contactPhone             String?  @map("contact_phone")
  contactWhatsappAvailable Boolean? @map("contact_whatsapp_available")

  jobs Job?

  @@map("contacts")
}

model Job {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Core job details
  role           String
  description    String
  status         String  @default("DRAFT") // constrained at application level
  jobDetailsJson String  @map("job_details_json") // JSON string containing JobDetails structure
  url            String? @map("url") // Optional URL source for the job posting

  // Relations & Foreign Keys
  companyId           Int          @map("company_id")
  contactId           Int?         @unique @map("contact_id")
  resumeId            Int?         @unique @map("resume_id")
  coverLetterId       Int?         @unique @map("cover_letter_id")
  resume              Resume?      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  coverLetter         CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact             Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  baseProfileAnalysis ATSAnalysis? @relation(fields: [aTSAnalysisId], references: [id], onDelete: Cascade)
  aTSAnalysisId       Int?         @unique @map("ats_analysis_id")

  // Profile this job was created from
  profileId Int?     @map("profile_id")
  profile   Profile? @relation(fields: [profileId], references: [id])

  @@map("jobs")
}

model Resume {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  contentJson String   @map("content_json") // JSON string containing ResumeJSON structure

  customizations  Customization    @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  customizationId Int              @unique @map("customization_id")
  jobs            Job?
  atsAnalysis     ATSAnalysis?     @relation(fields: [aTSAnalysisId], references: [id], onDelete: Cascade)
  aTSAnalysisId   Int?             @unique @map("ats_analysis_id")
  snapshots       ResumeSnapshot[]

  @@map("resumes")
}

model ResumeSnapshot {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  contentJson String   @map("content_json")
  label       String

  resumeId Int    @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_snapshots")
}

model CoverLetter {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  contentText String   @map("content_text")

  // Relations & Foreign Keys
  customizations  Customization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  customizationId Int           @unique @map("customization_id")
  jobs            Job?

  @@map("cover_letters")
}

model Customization {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Customization fields
  template   String // template name
  fontSize   String @map("font_size") // small, medium, large
  pageFormat String @map("page_format") // A4, Letter
  fontFamily String @map("font_family")
  lineHeight String @map("line_height") // tight, normal, relaxed
  marginSize String @map("margin_size") // CSV: top,right,bottom,left in inches (e.g. 1,1,1,1)
  colors     String @default("#3b82f6,#64748b,#8b5cf6,#1f2937,#ffffff")
  background String @default("none") // page background pattern id

  // ThemeConfig JSON (fonts/spacing/per-section overrides). Null = derive
  // from the legacy scalar columns above via legacyToTheme().
  themeJson String? @map("theme_json")

  resumes     Resume?
  coverLetter CoverLetter?

  @@map("customizations")
}

model TokenUsage {
  id       String @id @default(uuid())
  model    String
  provider String // openai, gemini, grok, perplexity, ollama, anthropic

  // Core token counts (all providers)
  promptTokens     Int @map("prompt_tokens")
  completionTokens Int @map("completion_tokens")
  totalTokens      Int @map("total_tokens")

  // Cache tokens — Anthropic: cache_read_input_tokens / cache_creation_input_tokens
  //                OpenAI: prompt_tokens_details.cached_tokens
  cacheReadTokens     Int? @map("cache_read_tokens")
  cacheCreationTokens Int? @map("cache_creation_tokens")

  // Reasoning tokens — OpenAI o-series: completion_tokens_details.reasoning_tokens
  reasoningTokens Int? @map("reasoning_tokens")

  // Cost
  costMicrocents Int? @map("cost_microcents") // costUSD * 1_000_000

  purpose    String // NEW_JOB, RESUME_FIELD_IMPROVEMENT, RESUME_GENERATION, COVER_LETTER_GENERATION, RESUME_PARSING, JOB_PARSING
  requestId  String?  @map("request_id")
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([model])
  @@index([createdAt])
  @@index([purpose])
  @@index([requestId])
  @@map("token_usage")
}

model ATSAnalysis {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  contentJson String   @map("content_json") // JSON string containing ATSAnalysisJSON structure

  jobs   Job?
  resume Resume?
}
