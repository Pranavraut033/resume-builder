---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getBase } from '../consts';

const title = 'Install steps · Udaan';
const description = 'Step-by-step install instructions for Udaan on macOS, Windows, and Linux, including how to get past the first-launch security warning.';

const base = getBase(import.meta.env.BASE_URL);
const entry = await getEntry('docs', 'install');
const { Content } = entry ? await render(entry) : { Content: null };
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-5 pt-16 pb-24">
    <p class="font-mono text-xs text-ink-muted">
      <a href={`${base}download`} class="underline underline-offset-4 hover:text-ink">← Download</a>
    </p>
    <p class="mt-6 font-mono text-xs tracking-[0.2em] text-ink-muted uppercase">Install steps</p>
    <h1 class="mt-5 font-display text-4xl tracking-tight text-balance sm:text-5xl">
      Getting past the first launch.
    </h1>
    {
      Content ? (
        <div class="prose mt-8">
          <Content />
        </div>
      ) : (
        <p class="mt-8 text-ink-muted">
          Couldn't load the install docs. See{' '}
          <a href="https://github.com/Pranavraut033/resume-builder#download--install" rel="noopener" class="underline underline-offset-4 hover:text-ink">
            the README on GitHub
          </a>.
        </p>
      )
    }
  </article>
</Base>
