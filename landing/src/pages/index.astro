---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Stats from '../components/sections/Stats.astro';
import Hook from '../components/sections/Hook.astro';
import Features from '../components/sections/Features.astro';
import Ats from '../components/sections/Ats.astro';
import CoverLetters from '../components/sections/CoverLetters.astro';
import Mcp from '../components/sections/Mcp.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Comparison from '../components/sections/Comparison.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const title = 'Udaan · a tailored resume and cover letter for every job';
const description =
  'Free, open-source desktop app that turns a job description and your base profile into a tailored, ATS-friendly resume and cover letter. Bring your own AI key or run Ollama locally, all data stays on your machine.';
---

<Base title={title} description={description}>
  <Hero />
  <Stats />
  <Hook />
  <Features />
  <Ats />
  <CoverLetters />
  <Mcp />
  <HowItWorks />
  <Comparison />
  <Faq limit={6} />
  <FinalCta />
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll engine: writes viewport progress (0–1) to --sp on each
  // [data-scroll] element ("pin" variant scrubs across the pinned stage).
  // Header elevation + document scroll progress (--dp) live in Base.astro
  // since every page needs them; this script only drives index-page effects.
  const tracked = reduced ? [] : [...document.querySelectorAll<HTMLElement>('[data-scroll]')];
  let ticking = false;

  const update = () => {
    ticking = false;
    const vh = window.innerHeight;
    for (const el of tracked) {
      const r = el.getBoundingClientRect();
      const p =
        el.dataset.scroll === 'pin'
          ? -r.top / Math.max(1, r.height - vh)
          : (vh - r.top) / (vh + r.height);
      el.style.setProperty('--sp', Math.min(1, Math.max(0, p)).toFixed(4));
    }
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  // Scroll reveal — only armed when motion is allowed
  if (!reduced) {
    document.documentElement.classList.add('motion-ok');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }

  // How-it-works: the step nearest viewport center drives the sticky
  // visual. Discrete state change, so it runs under reduced motion too
  // (transitions are disabled there in CSS).
  const visual = document.getElementById('how-visual');
  const stepEls = [...document.querySelectorAll('.how-step')];
  if (stepEls.length) {
    const stepIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const i = stepEls.indexOf(entry.target);
          if (visual) visual.dataset.state = String(i);
          stepEls.forEach((s, j) => s.classList.toggle('active', j === i));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    stepEls.forEach((s) => stepIO.observe(s));
  }

  // Signature interaction: the hero diff types tailored lines, one pair at a time.
  // The first pair is server-rendered, so no-JS and reduced-motion get a static diff.
  const pairs = [
    {
      del: 'Responsible for various web development tasks.',
      add: 'Rebuilt the checkout flow in React and TypeScript, halving page-load time.',
      meta: 'react · typescript · performance',
    },
    {
      del: 'Worked with databases and APIs.',
      add: 'Designed the PostgreSQL schema and REST APIs behind three customer-facing products.',
      meta: 'postgresql · rest apis · ownership',
    },
    {
      del: 'Team player with good communication skills.',
      add: 'Mentored two junior engineers and ran weekly architecture reviews.',
      meta: 'mentorship · leadership · communication',
    },
  ];

  const delEl = document.getElementById('diff-del');
  const addEl = document.getElementById('diff-add');
  const metaEl = document.getElementById('diff-meta');

  if (!reduced && delEl && addEl && metaEl) {
    let pair = 0;
    let i = 0;
    const TYPE_MS = 24;
    const HOLD_MS = 2800;

    const type = () => {
      const { add } = pairs[pair];
      if (i <= add.length) {
        addEl.textContent = add.slice(0, i);
        i += 1;
        setTimeout(type, TYPE_MS);
      } else {
        setTimeout(next, HOLD_MS);
      }
    };

    const next = () => {
      pair = (pair + 1) % pairs.length;
      i = 0;
      delEl.textContent = pairs[pair].del;
      metaEl.textContent = pairs[pair].meta;
      type();
    };

    addEl.textContent = '';
    type();
  }
</script>
