---
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const REPO = 'https://github.com/Pranavraut033/resume-builder';
const RELEASES = `${REPO}/releases`;

// Social scrapers (LinkedIn, Slack, X) reject relative image/URL values, so
// these are resolved against `site` from astro.config.mjs.
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;

// Build-time GitHub stats — fetched once at build, no client request, no
// runtime dependency. Falls back to static facts if the API call fails or
// rate-limits during CI, so a network hiccup never breaks the build or
// prints "undefined". Star count only shows once it clears STAR_THRESHOLD —
// a low count is anti-proof, so it's better omitted than shown.
const STAR_THRESHOLD = 25;
let repoStats = { stars: 0, downloads: 0, releaseCount: 7 };
try {
  const [repoRes, releasesRes] = await Promise.all([
    fetch('https://api.github.com/repos/Pranavraut033/resume-builder'),
    fetch('https://api.github.com/repos/Pranavraut033/resume-builder/releases'),
  ]);
  const repoJson = await repoRes.json();
  const releasesJson: { assets: { download_count: number }[] }[] = await releasesRes.json();
  repoStats = {
    stars: repoJson.stargazers_count ?? 0,
    downloads: releasesJson.reduce((sum, r) => sum + r.assets.reduce((s, a) => s + a.download_count, 0), 0),
    releaseCount: releasesJson.length,
  };
} catch {
  // Network failure or rate limit during build — static fallback above stands.
}

const title = 'Udaan — a tailored resume and cover letter for every job';
const description =
  'Free, open-source desktop app that turns a job description and your base profile into a tailored, ATS-friendly resume and cover letter. Bring your own AI key or run Ollama locally, all data stays on your machine.';

const steps = [
  {
    title: 'Paste the job description',
    body: 'Your chosen model parses it client-side into structured requirements: skills, keywords, responsibilities.',
  },
  {
    title: 'Get a tailored draft',
    body: 'The app rewrites your base profile into a resume and cover letter aimed at that specific role.',
  },
  {
    title: 'Refine it your way',
    body: 'Chat with the assistant — “make this bullet about leadership” — or click any line and edit it inline.',
  },
  {
    title: 'Export and track',
    body: 'Download the PDF or TXT, send it off, and move the application from Applied toward Offer.',
  },
];

// Reserved screenshot slots not yet captured (see plan: Part 1). Each
// renders as an obviously-unfinished dashed placeholder at the exact final
// aspect ratio, so dropping in the real PNG later is a file copy, no markup
// change. Never let one of these look "finished."
type Shot = { file: string; alt: string; ratio: string; label: string };
const shots: Record<string, Shot> = {
  ats: {
    file: 'ats-analysis.png',
    alt: 'ATS analysis panel showing match score, matched and missing keywords, knockout-risk flags, and title alignment',
    ratio: 'aspect-[16/10]',
    label: 'ats-analysis.png',
  },
  chat: {
    file: 'chat.png',
    alt: 'Chat assistant overlay mid-conversation, applying a requested edit to the resume',
    ratio: 'aspect-[16/10]',
    label: 'chat.png',
  },
  coverLetter: {
    file: 'cover-letter.png',
    alt: 'A generated cover letter with tone and style preset controls',
    ratio: 'aspect-[4/3]',
    label: 'cover-letter.png',
  },
  tracker: {
    file: 'tracker.png',
    alt: 'Application tracker table showing jobs across Draft, Applied, Interview, Offer, and Rejected',
    ratio: 'aspect-[16/9]',
    label: 'tracker.png',
  },
  customization: {
    file: 'customization.png',
    alt: 'Customization drawer open on a resume template, mid-restyle',
    ratio: 'aspect-[16/10]',
    label: 'customization.png',
  },
};

// Comparison table rows (Part 3)
const comparisonRows: [string, string, string, string][] = [
  ['Tailored per job', 'Yes', 'Yes — manually, every time', 'Mostly templates'],
  ['ATS-scored against the posting', 'Yes', 'No', 'Often paywalled'],
  ['Your data', 'Stays on your machine', 'Sent to OpenAI', 'Stored on their servers'],
  ['Tracks applications', 'Yes', 'No', 'Paid tiers only'],
  ['Cost', 'Free + your own API key', 'Subscription', '$10–30/month'],
  ['Formatting', 'PDF/TXT, WYSIWYG editor', 'You rebuild it by hand', 'Locked to their templates'],
];

// FAQ (Part 3)
const faqs: [string, string][] = [
  [
    'Does the API key actually cost anything?',
    'A few cents per resume with most providers — you pay them directly, at their rates. Or skip keys entirely and run a local Ollama model for free.',
  ],
  [
    'Can it run fully offline?',
    'Yes. Point it at a local Ollama model and every AI call happens on your machine, no network request, no account.',
  ],
  [
    'Does my data ever leave my machine?',
    'Only the text you send to whichever AI provider you chose — the same as pasting into ChatGPT. Everything else — your profile, jobs, resumes — lives in a local SQLite database Udaan never uploads.',
  ],
  [
    'Will an ATS actually parse the exported PDF?',
    'Yes — the PDF export uses standard text layout, not images or exotic fonts, which is what most ATS parsers choke on.',
  ],
  [
    "Will it write things I didn't actually do?",
    "It rewrites your base profile, not invents one. Every AI edit is a suggested change you review before it's applied — nothing exports without you seeing it first.",
  ],
  [
    'Why does my OS show a scary warning on first launch?',
    'Udaan is self-signed, not paid-publisher signed, so macOS and Windows show a one-time warning for any app outside their stores. See the note below the download button for the two-click fix.',
  ],
];

// Renders one placeholder slot. All interpolated values are our own static
// strings from `shots` above (no user input), so building the markup as a
// string and injecting via set:html is safe and keeps one definition instead
// of repeating the block at every one of the 5 call sites.
function shotPlaceholder(shot: Shot, extraClass = '') {
  return `<div class="shot-placeholder ${shot.ratio} w-full ${extraClass}" role="img" aria-label="${shot.alt}">
    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.5"></circle><path d="m3 16 5-5 4 4 3-3 6 6"></path></svg>
    <p class="font-mono text-xs">${shot.label}</p>
  </div>`;
}

// Final CTA: the emphasized clause split into characters for the split-flap
// entrance (Part 5, effect 8). Plain server-rendered text sits alongside via
// the sr-only sibling below, so no-JS/no-CSS readers get the real sentence.
const flapText = 'is one udaan away.';

// Hook sentence, split into words at build time for the scroll-scrubbed
// reveal. 's' = struck words, 'ins' = inserted words. A sr-only sibling
// carries the real <s>/<ins> semantics.
const hookWords: [string, ('s' | 'ins')?][] = [
  ['Job'],
  ['hunting'],
  ['is'],
  ['a'],
  ['grind.'],
  ['One'],
  ['generic'],
  ['resume'],
  ['for'],
  ['every', 's'],
  ['job', 's'],
  ['a', 'ins'],
  ['tailored', 'ins'],
  ['one', 'ins'],
  ['for'],
  ['each'],
  ['is'],
  ['what'],
  ['gets'],
  ['you'],
  ['hired.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Udaan" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Udaan — every application deserves its own resume. Local-first AI resume and cover letter tailoring."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0d1117" />
    <!-- Cloudflare Web Analytics: pageviews + Core Web Vitals only, no PII, no cookie banner needed -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "ebc729c0ef5640c6b6814c45ccaf4fea"}'
    ></script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/x-icon" sizes="any" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.theme || 'dark';
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-accent"
    >
      Skip to content
    </a>

    <header id="site-header" class="sticky top-0 z-40 border-b bg-surface/85 backdrop-blur">
      <nav aria-label="Main" class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
        <a href="#main" class="flex items-center gap-2 font-mono text-sm font-semibold tracking-tight">
          <img src={`${base}favicon.svg`} alt="" width="20" height="20" class="rounded-md" />
          udaan
        </a>
        <div class="hidden items-center gap-6 text-sm text-ink-muted sm:flex">
          <a href="#features" class="transition-colors hover:text-ink">Features</a>
          <a href="#how" class="transition-colors hover:text-ink">How it works</a>
          <a href={REPO} rel="noopener" class="transition-colors hover:text-ink">GitHub</a>
        </div>
        <div class="flex items-center gap-2.5">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle between white and dark theme"
            class="inline-grid size-9 place-items-center rounded-lg border border-line bg-raised text-ink-muted transition-colors hover:border-accent-2 hover:text-ink dark:hover:text-accent-2"
          >
            <svg class="dark:hidden" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
            <svg class="hidden dark:block" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
            </svg>
          </button>
          <a
            href={RELEASES}
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3.5 py-1.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
          >
            Download
          </a>
        </div>
      </nav>
      <div id="progress-hairline" aria-hidden="true" class="absolute inset-x-0 -bottom-px h-0.5 bg-accent"></div>
    </header>

    <main id="main">
      <!-- ============ Hero — pinned: the diff card settles as you scroll ============ -->
      <section id="hero-stage" data-scroll="pin">
        <div class="pin-content">
          <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-5 pt-16 pb-20 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
            <div class="hero-copy min-w-0">
              <p class="reveal font-mono text-xs tracking-[0.2em] text-ink-muted uppercase">
                Free · Open source · macOS / Windows / Linux
              </p>
              <h1 class="reveal mt-5 font-display text-5xl leading-[0.95] tracking-tight text-balance sm:text-6xl lg:text-7xl xl:text-8xl">
                Every application,
                <em class="block text-accent">ready for takeoff.</em>
              </h1>
              <p class="reveal reveal-2 mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
                Paste a job description. Get a resume and cover letter written for
                <em>that</em> posting — keyword-matched, ATS-scored, and edited by you before it
                ever leaves your machine.
              </p>
              <div class="reveal reveal-3 mt-8 flex flex-wrap items-center gap-3">
                <a
                  href={RELEASES}
                  rel="noopener"
                  class="btn-block inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-accent"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M7.25 1.5a.75.75 0 0 1 1.5 0v7.69l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 0 1 1.06-1.06l2.72 2.72V1.5Z"></path>
                    <path d="M2 13.25a.75.75 0 0 1 .75.75v.5h10.5V14a.75.75 0 0 1 1.5 0v.5c0 .83-.67 1.5-1.5 1.5H2.75c-.83 0-1.5-.67-1.5-1.5V14a.75.75 0 0 1 .75-.75Z"></path>
                  </svg>
                  Download for free
                </a>
                <a
                  href={REPO}
                  rel="noopener"
                  class="inline-flex items-center gap-2 rounded-lg border border-line bg-raised px-5 py-3 text-sm font-semibold transition-colors hover:border-accent/50"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
                  </svg>
                  View on GitHub
                </a>
              </div>
              <p class="reveal reveal-3 mt-5 font-mono text-xs text-ink-muted">
                Free forever · your own API key (a few cents per resume) or Ollama, fully offline
              </p>
            </div>

            <figure class="reveal reveal-2 tilt-wrap min-w-0">
              <div class="tilt-card overflow-hidden rounded-2xl border border-term-line bg-term shadow-2xl shadow-black/25">
                <div class="flex items-center gap-2 border-b border-term-line px-4 py-3">
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-term-del/80"></span>
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-accent-2/80"></span>
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-term-add/80"></span>
                  <span class="ml-2 min-w-0 truncate font-mono text-xs text-term-muted">
                    tailoring resume.pdf → senior-frontend-engineer
                  </span>
                </div>
                <div aria-hidden="true" class="space-y-1.5 p-5 font-mono text-[13px] leading-6">
                  <p class="text-term-muted">@@ experience · acme corp @@</p>
                  <p class="text-term-fg">&nbsp;&nbsp;Software Engineer · 2021 — 2025</p>
                  <p class="rounded-lg bg-term-del-soft px-2 text-term-del">
                    - <s id="diff-del">Responsible for various web development tasks.</s>
                  </p>
                  <p class="min-h-18 rounded-lg bg-term-add-soft px-2 text-term-add sm:min-h-12">
                    + <span id="diff-add">Rebuilt the checkout flow in React and TypeScript, halving page-load time.</span><span class="caret select-none">▍</span>
                  </p>
                  <p class="pt-2 text-term-muted">
                    keywords matched: <span id="diff-meta" class="text-term-fg/80">react · typescript · performance</span>
                  </p>
                </div>
              </div>
              <figcaption class="sr-only">
                Example of tailoring: a generic resume line is removed and replaced with a line written
                for the specific job, with matched keywords listed underneath.
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ============ Stats strip — honest facts, no invented testimonials ============ -->
      <div class="border-y border-line bg-raised px-5 py-4">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-2 font-mono text-xs text-ink-muted">
          {repoStats.stars >= STAR_THRESHOLD && <span>★ {repoStats.stars}</span>}
          <span>{repoStats.downloads} downloads</span>
          <span>{repoStats.releaseCount} releases</span>
          <span>MIT licensed</span>
        </div>
      </div>

      <!-- ============ Hook — cinematic band, words light up as you scroll ============ -->
      <section data-scroll class="relative border-y border-term-line bg-term">
        <div class="backdrop backdrop-scan" aria-hidden="true"></div>
        <div class="mx-auto max-w-4xl px-5 py-28 text-center md:py-44">
          <p aria-hidden="true" class="wreveal font-display text-3xl leading-snug text-term-fg text-balance sm:text-4xl md:text-5xl">
            {
              hookWords.map(([w, kind], i) => (
                <span
                  data-w
                  class={kind === 's' ? 'wd-s text-term-del' : kind === 'ins' ? 'text-term-add' : ''}
                  style={`--i:${i}`}
                >
                  {w}
                </span>
              ))
            }
          </p>
          <p class="sr-only">
            Job hunting is a grind. One generic resume for <s>every job</s> <ins>a tailored one for each</ins> is what gets you hired.
          </p>
        </div>
      </section>

      <!-- ============ Features ============ -->
      <section id="features" data-scroll class="relative isolate mx-auto max-w-6xl scroll-mt-16 px-5 py-24 md:py-32">
        <p
          aria-hidden="true"
          class="ghost-num pointer-events-none absolute -top-4 right-0 -z-10 font-mono text-[7rem] leading-none font-bold tracking-tighter text-ink/[0.04] select-none md:text-[11rem] dark:text-ink/[0.07]"
        >
          01
        </p>
        <p class="tint-eyebrow reveal flex w-fit items-center rounded-lg px-2.5 py-1 font-mono text-xs font-bold tracking-[0.18em]">
          @@ features @@
        </p>
        <h2 class="reveal mt-5 max-w-2xl font-display text-4xl tracking-tight text-balance sm:text-5xl">
          Everything between paste and send.
        </h2>

        <!-- Anchor panel: the editor itself, full width, terminal chrome — the real product, legible -->
        <div class="reveal reveal-2 mt-14 grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr]">
          <div class="max-w-md">
            <h3 class="text-xl font-semibold">Edit the document, not a form</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              The inline editor <em>is</em> the resume. Click any line on the rendered page and
              type — what you see on screen is exactly what exports to PDF.
            </p>
          </div>
          <figure class="overflow-hidden rounded-2xl border border-term-line bg-term shadow-block">
            <div class="flex items-center gap-2 border-b border-term-line px-4 py-3">
              <span aria-hidden="true" class="size-2.5 rounded-full bg-term-del/80"></span>
              <span aria-hidden="true" class="size-2.5 rounded-full bg-accent-2/80"></span>
              <span aria-hidden="true" class="size-2.5 rounded-full bg-term-add/80"></span>
              <span class="ml-2 font-mono text-xs text-term-muted">editor · resume.pdf</span>
            </div>
            <img
              src={`${base}screenshots/editor.png`}
              alt="The inline WYSIWYG resume editor showing a tailored resume with the toolbar for PDF export, templates, sections, ATS analysis, humanizing, and chat"
              width="1440"
              height="940"
              loading="lazy"
              class="aspect-[16/10] w-full object-cover object-top"
            />
          </figure>
        </div>

        <!-- Chat assistant: wide two-col terminal panel, same visual family as the hero card -->
        <div class="reveal mt-16 grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="max-w-md">
            <h3 class="text-xl font-semibold">An editor you can talk to</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              Ask the built-in assistant to rewrite a bullet, tighten your summary, or map the
              job&rsquo;s keywords onto your experience. Running client-side through whichever
              provider you picked.
            </p>
          </div>
          <div class="space-y-3 rounded-2xl border border-term-line bg-term p-5 text-sm text-term-fg shadow-block">
            <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-accent px-3.5 py-2 text-on-accent">
              Make the second bullet lead with impact.
            </p>
            <div class="w-fit max-w-[90%] rounded-2xl rounded-bl-sm border border-term-line bg-term/60 px-3.5 py-2">
              Rewritten to lead with the result — want it more concise?
              <p class="mt-2 rounded-lg bg-term-add-soft px-2 py-1 font-mono text-xs text-term-add">
                + Halved page-load time by rebuilding checkout in React.
              </p>
            </div>
          </div>
        </div>

        <!-- Privacy / providers — an inline mono list, not a card wrapping a list -->
        <div class="reveal mt-16 max-w-2xl">
          <h3 class="text-xl font-semibold">Your keys. Your machine. Your choice of AI.</h3>
          <p class="mt-3 leading-relaxed text-ink-muted">
            Bring an API key for any major provider — or point the app at a local Ollama model and
            skip keys entirely. Every AI call runs client-side, keys sit in encrypted local
            storage, and your data lives in a local SQLite database.
          </p>
          <ul class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-ink-muted" aria-label="Supported AI providers">
            {
              ['OpenAI', 'Anthropic Claude', 'Google Gemini', 'xAI Grok', 'Perplexity'].map((p) => (
                <li>{p}</li>
              ))
            }
            <li class="text-add">+ Ollama, fully local</li>
          </ul>
        </div>

        <!-- Job tracker — diff-styled status pills, inline near the copy -->
        <div class="reveal mt-16 max-w-2xl">
          <h3 class="text-xl font-semibold">Every application, tracked</h3>
          <p class="mt-3 leading-relaxed text-ink-muted">
            Each job keeps its own tailored resume, cover letter, and status — from first draft to
            signed offer.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs" aria-label="Application statuses">
            <li class="rounded-lg border border-line px-2 py-1 text-ink-muted">draft</li>
            <li class="rounded-lg border border-accent/40 bg-accent/10 px-2 py-1 text-accent">applied</li>
            <li class="rounded-lg border border-warn/40 bg-warn/10 px-2 py-1 text-warn">interview</li>
            <li class="rounded-lg border border-add/40 bg-add-soft px-2 py-1 text-add">+ offer</li>
            <li class="rounded-lg border border-del/40 bg-del-soft px-2 py-1 text-del">- rejected</li>
          </ul>
        </div>

