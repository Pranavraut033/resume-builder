---
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const REPO = 'https://github.com/Pranavraut033/resume-builder';
const RELEASES = `${REPO}/releases`;

const title = 'Udaan — give your career the takeoff it deserves';
const description =
  'Free, open-source desktop app that turns a job description and your base profile into a tailored, ATS-friendly resume and cover letter — so every application is your best shot at flight. Bring your own AI key or run Ollama locally, all data stays on your machine.';

const steps = [
  {
    title: 'Paste the job description',
    body: 'Your chosen model parses it client-side into structured requirements: skills, keywords, responsibilities.',
  },
  {
    title: 'Get a tailored draft',
    body: 'The app rewrites your base profile into a resume and cover letter aimed at that specific role.',
  },
  {
    title: 'Refine it your way',
    body: 'Chat with the assistant — “make this bullet about leadership” — or click any line and edit it inline.',
  },
  {
    title: 'Export and track',
    body: 'Download the PDF or TXT, send it off, and move the application from Applied toward Offer.',
  },
];

// Hook sentence, split into words at build time for the scroll-scrubbed
// reveal. 's' = struck words, 'ins' = inserted words. A sr-only sibling
// carries the real <s>/<ins> semantics.
const hookWords: [string, ('s' | 'ins')?][] = [
  ['Every'],
  ['career'],
  ['needs'],
  ['a'],
  ['runway.'],
  ['One'],
  ['generic'],
  ['resume'],
  ['for'],
  ['every', 's'],
  ['job', 's'],
  ['a', 'ins'],
  ['tailored', 'ins'],
  ['one', 'ins'],
  ['for'],
  ['each'],
  ['is'],
  ['what'],
  ['gets'],
  ['you'],
  ['airborne.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.theme || 'light';
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-accent"
    >
      Skip to content
    </a>

    <header id="site-header" class="sticky top-0 z-40 border-b bg-surface/85 backdrop-blur">
      <nav aria-label="Main" class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
        <a href="#main" class="font-mono text-sm font-semibold tracking-tight">
          <span aria-hidden="true" class="text-add">+</span> udaan
        </a>
        <div class="hidden items-center gap-6 text-sm text-ink-muted sm:flex">
          <a href="#features" class="transition-colors hover:text-ink">Features</a>
          <a href="#how" class="transition-colors hover:text-ink">How it works</a>
          <a href={REPO} rel="noopener" class="transition-colors hover:text-ink">GitHub</a>
        </div>
        <div class="flex items-center gap-2.5">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle between white and dark theme"
            class="inline-grid size-9 place-items-center rounded-lg border border-line bg-raised text-ink-muted transition-colors hover:border-accent-2 hover:text-ink dark:hover:text-accent-2"
          >
            <svg class="dark:hidden" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
            <svg class="hidden dark:block" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
            </svg>
          </button>
          <a
            href={RELEASES}
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3.5 py-1.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
          >
            Download
          </a>
        </div>
      </nav>
      <div id="progress-hairline" aria-hidden="true" class="absolute inset-x-0 -bottom-px h-0.5 bg-accent"></div>
    </header>

    <main id="main">
      <!-- ============ Hero — pinned: the diff card settles as you scroll ============ -->
      <section id="hero-stage" data-scroll="pin">
        <div class="pin-content">
          <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-5 pt-16 pb-20 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
            <div class="hero-copy min-w-0">
              <p class="reveal font-mono text-xs tracking-[0.2em] text-ink-muted uppercase">
                Free · Open source · macOS / Windows / Linux
              </p>
              <h1 class="reveal mt-5 font-display text-5xl leading-[0.95] tracking-tight text-balance sm:text-6xl lg:text-7xl xl:text-8xl">
                Every application,
                <em class="block text-accent">ready for takeoff.</em>
              </h1>
              <p class="reveal reveal-2 mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
                Udaan is a desktop app that reads a job description and rewrites your base profile
                into an ATS-friendly resume and cover letter — with an AI provider you choose, on
                data that never leaves your machine. One job closer, every time.
              </p>
              <div class="reveal reveal-3 mt-8 flex flex-wrap items-center gap-3">
                <a
                  href={RELEASES}
                  rel="noopener"
                  class="btn-block inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-accent"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M7.25 1.5a.75.75 0 0 1 1.5 0v7.69l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 0 1 1.06-1.06l2.72 2.72V1.5Z"></path>
                    <path d="M2 13.25a.75.75 0 0 1 .75.75v.5h10.5V14a.75.75 0 0 1 1.5 0v.5c0 .83-.67 1.5-1.5 1.5H2.75c-.83 0-1.5-.67-1.5-1.5V14a.75.75 0 0 1 .75-.75Z"></path>
                  </svg>
                  Download for free
                </a>
                <a
                  href={REPO}
                  rel="noopener"
                  class="inline-flex items-center gap-2 rounded-lg border border-line bg-raised px-5 py-3 text-sm font-semibold transition-colors hover:border-accent/50"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
                  </svg>
                  View on GitHub
                </a>
              </div>
              <p class="reveal reveal-3 mt-5 font-mono text-xs text-ink-muted">
                MIT licensed · bring your own API key, or run Ollama locally
              </p>
            </div>

            <figure class="reveal reveal-2 tilt-wrap min-w-0">
              <div class="tilt-card overflow-hidden rounded-2xl border border-term-line bg-term shadow-2xl shadow-black/25">
                <div class="flex items-center gap-2 border-b border-term-line px-4 py-3">
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-term-del/80"></span>
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-accent-2/80"></span>
                  <span aria-hidden="true" class="size-2.5 rounded-full bg-term-add/80"></span>
                  <span class="ml-2 min-w-0 truncate font-mono text-xs text-term-muted">
                    tailoring resume.pdf → senior-frontend-engineer
                  </span>
                </div>
                <div aria-hidden="true" class="space-y-1.5 p-5 font-mono text-[13px] leading-6">
                  <p class="text-term-muted">@@ experience · acme corp @@</p>
                  <p class="text-term-fg">&nbsp;&nbsp;Software Engineer · 2021 — 2025</p>
                  <p class="rounded-md bg-term-del-soft px-2 text-term-del">
                    - <s id="diff-del">Responsible for various web development tasks.</s>
                  </p>
                  <p class="min-h-18 rounded-md bg-term-add-soft px-2 text-term-add sm:min-h-12">
                    + <span id="diff-add">Rebuilt the checkout flow in React and TypeScript, halving page-load time.</span><span class="caret select-none">▍</span>
                  </p>
                  <p class="pt-2 text-term-muted">
                    keywords matched: <span id="diff-meta" class="text-term-fg/80">react · typescript · performance</span>
                  </p>
                </div>
              </div>
              <figcaption class="sr-only">
                Example of tailoring: a generic resume line is removed and replaced with a line written
                for the specific job, with matched keywords listed underneath.
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ============ Hook — cinematic band, words light up as you scroll ============ -->
      <section data-scroll class="border-y border-term-line bg-term">
        <div class="mx-auto max-w-4xl px-5 py-28 text-center md:py-44">
          <p aria-hidden="true" class="wreveal font-display text-3xl leading-snug text-term-fg text-balance sm:text-4xl md:text-5xl">
            {
              hookWords.map(([w, kind], i) => (
                <span
                  data-w
                  class={kind === 's' ? 'wd-s text-term-del' : kind === 'ins' ? 'text-term-add' : ''}
                  style={`--i:${i}`}
                >
                  {w}
                </span>
              ))
            }
          </p>
          <p class="sr-only">
            Every career needs a runway. One generic resume for <s>every job</s> <ins>a tailored one for each</ins> is what gets you airborne.
          </p>
        </div>
      </section>

      <!-- ============ Features ============ -->
      <section id="features" data-scroll class="relative isolate mx-auto max-w-6xl scroll-mt-16 px-5 py-24 md:py-32">
        <p
          aria-hidden="true"
          class="ghost-num pointer-events-none absolute -top-4 right-0 -z-10 font-mono text-[7rem] leading-none font-bold tracking-tighter text-ink/[0.04] select-none md:text-[11rem] dark:text-ink/[0.07]"
        >
          01
        </p>
        <p class="reveal flex w-fit items-center rounded-md bg-accent-2 px-2.5 py-1 font-mono text-xs font-bold tracking-[0.18em] text-blocky-ink">
          @@ features @@
        </p>
        <h2 class="reveal mt-5 max-w-2xl font-display text-4xl tracking-tight text-balance sm:text-5xl">
          Everything between paste and send.
        </h2>

        <div class="mt-12 grid gap-5 md:grid-cols-2">
          <!-- AI chat assistant -->
          <article class="reveal rounded-3xl border border-transparent bg-raised p-7 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="text-xl font-semibold">An editor you can talk to</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              Ask the built-in assistant to rewrite a bullet, tighten your summary, or map the
              job&rsquo;s keywords onto your experience. It answers questions about your resume and
              helps you prep for the interview — running client-side through whichever provider you
              picked.
            </p>
            <div class="mt-6 space-y-3 rounded-xl border border-line bg-surface p-4 text-sm">
              <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-accent px-3.5 py-2 text-on-accent">
                Make the second bullet lead with impact.
              </p>
              <div class="w-fit max-w-[90%] rounded-2xl rounded-bl-sm border border-line bg-raised px-3.5 py-2">
                Rewritten to lead with the result — want it more concise?
                <p class="mt-2 rounded-md bg-add-soft px-2 py-1 font-mono text-xs text-add">
                  + Halved page-load time by rebuilding checkout in React.
                </p>
              </div>
            </div>
          </article>

          <!-- Inline WYSIWYG editor -->
          <article class="reveal reveal-2 rounded-3xl border border-transparent bg-raised p-7 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="text-xl font-semibold">Edit the document, not a form</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              The inline editor <em>is</em> the resume. Click any line on the rendered page and
              type — what you see on screen is exactly what exports to PDF.
            </p>
            <img
              src={`${base}screenshots/editor.png`}
              alt="The inline WYSIWYG resume editor showing a tailored resume with the toolbar for PDF export, templates, sections, ATS analysis, humanizing, and chat"
              width="1440"
              height="940"
              loading="lazy"
              class="mt-6 aspect-[16/10] w-full rounded-xl border border-line object-cover object-top"
            />
          </article>

          <!-- Privacy / multi-LLM -->
          <article class="reveal rounded-3xl border border-transparent bg-raised p-7 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="text-xl font-semibold">Your keys. Your machine. Your choice of AI.</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              Bring an API key for any major provider — or point the app at a local Ollama model
              and skip keys entirely. Every AI call runs client-side, keys sit in encrypted local
              storage, and your data lives in a local SQLite database. Nothing touches a server you
              don&rsquo;t control.
            </p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Supported AI providers">
              {
                ['OpenAI', 'Anthropic Claude', 'Google Gemini', 'xAI Grok', 'Perplexity'].map((p) => (
                  <li class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-ink-muted">{p}</li>
                ))
              }
              <li class="rounded-full border border-add/40 bg-add-soft px-3 py-1 font-mono text-xs text-add">
                Ollama · fully local
              </li>
            </ul>
          </article>

          <!-- Job tracker -->
          <article class="reveal reveal-2 rounded-3xl border border-transparent bg-raised p-7 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="text-xl font-semibold">Every application, tracked</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">
              Each job keeps its own tailored resume, cover letter, and status. See where every
              application stands, from first draft to signed offer.
            </p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Application statuses">
              <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-ink-muted"></span>Draft
              </li>
              <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>Applied
              </li>
              <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-warn"></span>Interview
              </li>
              <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-add"></span>Offer
              </li>
              <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-ink-muted">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-del"></span>Rejected
              </li>
            </ul>
          </article>
        </div>

        <div class="mt-5 grid gap-5 md:grid-cols-3">
          <article class="reveal rounded-3xl border border-transparent bg-raised p-6 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="font-semibold">Templates that flex</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Multiple resume templates with per-job color, font, and layout customization.
            </p>
            <div class="mt-4 grid grid-cols-3 gap-2">
              {
                [
                  { file: 'template-tech-sidebar', name: 'Tech Sidebar' },
                  { file: 'template-modern-minimal', name: 'Modern Minimal' },
                  { file: 'template-creative-modern', name: 'Creative Modern' },
                ].map((tpl) => (
                  <img
                    src={`${base}screenshots/${tpl.file}.png`}
                    alt={`${tpl.name} resume template`}
                    width="866"
                    height="1120"
                    loading="lazy"
                    class="aspect-[3/4] rounded-md border border-line object-cover object-top"
                  />
                ))
              }
            </div>
          </article>
          <article class="reveal reveal-2 rounded-3xl border border-transparent bg-raised p-6 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="font-semibold">Export, apply</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              One-click PDF and TXT export — application-ready documents for portals and ATS
              uploads alike.
            </p>
          </article>
          <article class="reveal reveal-3 rounded-3xl border border-transparent bg-raised p-6 transition duration-300 hover:-translate-y-1 hover:shadow-block-lg dark:border-line">
            <h3 class="font-semibold">Native on desktop</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Built with Tauri: a lightweight app for macOS, Windows, and Linux, installed straight
              from GitHub Releases.
            </p>
          </article>
        </div>
      </section>

      <!-- ============ How it works — sticky walkthrough ============ -->
      <section id="how" data-scroll class="scroll-mt-16 border-t border-line bg-raised">
        <div class="relative isolate mx-auto max-w-6xl px-5 py-24 md:py-32">
          <p
            aria-hidden="true"
            class="ghost-num pointer-events-none absolute top-12 right-0 -z-10 font-mono text-[7rem] leading-none font-bold tracking-tighter text-ink/[0.05] select-none md:text-[11rem] dark:text-ink/[0.07]"
          >
            02
          </p>
          <p class="reveal flex w-fit items-center rounded-md bg-accent-2 px-2.5 py-1 font-mono text-xs font-bold tracking-[0.18em] text-blocky-ink">
            @@ how it works @@
          </p>
          <h2 class="reveal mt-5 font-display text-4xl tracking-tight text-balance sm:text-5xl">
            From job post to cleared for takeoff.
          </h2>

          <div class="mt-14 gap-16 lg:grid lg:grid-cols-2">
            <!-- Sticky visual: one pane per step, crossfaded by scroll position -->
            <div class="hidden lg:block">
              <div id="how-visual" data-state="0" aria-hidden="true" class="sticky top-24">
                <div class="relative h-104">
                  <div data-pane="0" class="how-pane absolute inset-0 flex items-center">
                    <div class="w-full overflow-hidden rounded-2xl border border-line bg-surface shadow-sm">
                      <div class="border-b border-line px-4 py-2.5 font-mono text-xs text-ink-muted">new application</div>
                      <div class="space-y-3 p-5">
                        <p class="font-semibold">Senior Frontend Engineer</p>
                        <p class="text-sm text-ink-muted">Acme Corp · Remote</p>
                        <p class="rounded-lg border border-line bg-raised p-3 font-mono text-xs leading-5 text-ink-muted">
                          We're looking for an engineer with deep React and TypeScript experience.
                          You'll own performance across our checkout flow and work closely with
                          design…
                        </p>
                        <span class="btn-block inline-flex rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-on-accent">Parse with AI</span>
                      </div>
                    </div>
                  </div>
                  <div data-pane="1" class="how-pane absolute inset-0 flex items-center">
                    <div class="w-full overflow-hidden rounded-2xl border border-term-line bg-term shadow-sm">
                      <div class="border-b border-term-line px-4 py-2.5 font-mono text-xs text-term-muted">tailored draft</div>
                      <div class="space-y-1.5 p-5 font-mono text-xs leading-6">
                        <p class="text-term-muted">@@ summary @@</p>
                        <p class="rounded bg-term-del-soft px-2 text-term-del">- Hardworking developer seeking new opportunities.</p>
                        <p class="rounded bg-term-add-soft px-2 text-term-add">+ Frontend engineer specializing in React performance.</p>
                        <p class="rounded bg-term-add-soft px-2 text-term-add">+ Owned checkout, halving page-load time.</p>
                        <p class="pt-1 text-term-muted">keywords: react · typescript · performance</p>
                      </div>
                    </div>
                  </div>
                  <div data-pane="2" class="how-pane absolute inset-0 flex items-center">
                    <div class="w-full space-y-3 rounded-2xl border border-line bg-surface p-5 text-sm shadow-sm">
                      <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-accent px-3.5 py-2 text-on-accent">
                        Make it lead with impact.
                      </p>
                      <div class="w-fit max-w-[90%] rounded-2xl rounded-bl-sm border border-line bg-raised px-3.5 py-2">
                        Done — leading with the result now.
                        <p class="mt-2 rounded-md bg-add-soft px-2 py-1 font-mono text-xs text-add">
                          + Halved page-load time by rebuilding checkout.
                        </p>
                      </div>
                      <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-accent px-3.5 py-2 text-on-accent">
                        Perfect. Tighten the summary too.
                      </p>
                    </div>
                  </div>
                  <div data-pane="3" class="how-pane absolute inset-0 flex items-center">
                    <div class="w-full rounded-2xl border border-line bg-surface p-5 shadow-sm">
                      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
                        <p class="min-w-0 truncate font-mono text-sm font-semibold">acme-corp · resume.pdf</p>
                        <div class="flex gap-2">
                          <span class="rounded-md bg-accent px-2.5 py-1 text-xs font-semibold text-on-accent">PDF</span>
                          <span class="rounded-md border border-line px-2.5 py-1 text-xs font-semibold text-ink-muted">TXT</span>
                        </div>
                      </div>
                      <ul class="mt-4 flex flex-wrap gap-2">
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-ink-muted">
                          <span class="size-1.5 rounded-full bg-ink-muted"></span>Draft
                        </li>
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/50 bg-accent/10 px-3 py-1 font-mono text-xs">
                          <span class="size-1.5 rounded-full bg-accent"></span>Applied
                        </li>
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-ink-muted">
                          <span class="size-1.5 rounded-full bg-warn"></span>Interview
                        </li>
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 font-mono text-xs text-ink-muted">
                          <span class="size-1.5 rounded-full bg-add"></span>Offer
                        </li>
                      </ul>
                      <p class="mt-4 font-mono text-xs text-ink-muted">status: applied → keep going</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <ol class="grid gap-10 sm:grid-cols-2 lg:block">
              {
                steps.map((step, i) => (
                  <li class={`how-step ${i === 0 ? 'active' : ''} lg:flex lg:min-h-[55svh] lg:flex-col lg:justify-center`}>
                    <span class="step-chip inline-grid size-9 place-items-center rounded-lg border border-line bg-surface font-mono text-sm text-accent">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
                    <p class="mt-2 max-w-md leading-relaxed text-ink-muted">{step.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- ============ Final CTA — cinematic bookend ============ -->
      <section class="border-t border-term-line bg-term">
        <div class="mx-auto max-w-3xl px-5 py-24 text-center md:py-36">
          <p class="reveal mx-auto w-fit font-mono text-xs tracking-[0.2em] text-accent-2">@@ cleared for takeoff @@</p>
          <h2 class="reveal mt-5 font-display text-4xl leading-tight tracking-tight text-balance text-term-fg sm:text-5xl md:text-6xl">
            Your next role <em class="text-term-accent">is one udaan away.</em>
          </h2>
          <div class="reveal reveal-2 mt-9 flex flex-wrap items-center justify-center gap-3">
            <a
              href={RELEASES}
              rel="noopener"
              class="btn-block inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3.5 font-semibold text-on-accent"
            >
              Download for free
            </a>
            <a
              href={REPO}
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-term-line px-6 py-3.5 font-semibold text-term-fg transition-colors hover:border-term-accent/60"
            >
              Read the source
            </a>
          </div>
          <p class="reveal reveal-3 mt-6 font-mono text-xs text-term-muted">
            Free forever · MIT licensed · no subscription, no sign-up, no cloud storage
          </p>
        </div>
      </section>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between">
        <p>
          <span class="font-mono font-semibold text-ink"><span aria-hidden="true" class="text-add">+</span> udaan</span>
          ·
          <a href={`${REPO}/blob/main/LICENSE`} rel="noopener" class="underline-offset-4 transition-colors hover:text-ink hover:underline">MIT License</a>
          · Resume templates adapted from
          <a href="https://github.com/Afif718/Resumify" rel="noopener" class="underline-offset-4 transition-colors hover:text-ink hover:underline">Resumify</a>
        </p>
        <nav aria-label="Footer" class="flex gap-5">
          <a href={REPO} rel="noopener" class="transition-colors hover:text-ink">GitHub</a>
          <a href={RELEASES} rel="noopener" class="transition-colors hover:text-ink">Releases</a>
          <a href={`${REPO}/issues`} rel="noopener" class="transition-colors hover:text-ink">Issues</a>
        </nav>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Theme toggle — head script already set data-theme before paint
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.theme = next;
      });

      // Scroll engine: writes viewport progress (0–1) to --sp on each
      // [data-scroll] element ("pin" variant scrubs across the pinned stage),
      // document progress to --dp, and toggles header elevation.
      const header = document.getElementById('site-header');
      const tracked = reduced ? [] : [...document.querySelectorAll<HTMLElement>('[data-scroll]')];
      let ticking = false;

      const update = () => {
        ticking = false;
        const vh = window.innerHeight;
        const doc = document.documentElement;
        doc.style.setProperty('--dp', (window.scrollY / Math.max(1, doc.scrollHeight - vh)).toFixed(4));
        header?.classList.toggle('scrolled', window.scrollY > 8);
        for (const el of tracked) {
          const r = el.getBoundingClientRect();
          const p =
            el.dataset.scroll === 'pin'
              ? -r.top / Math.max(1, r.height - vh)
              : (vh - r.top) / (vh + r.height);
          el.style.setProperty('--sp', Math.min(1, Math.max(0, p)).toFixed(4));
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();

      // Scroll reveal — only armed when motion is allowed
      if (!reduced) {
        document.documentElement.classList.add('motion-ok');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }

      // How-it-works: the step nearest viewport center drives the sticky
      // visual. Discrete state change, so it runs under reduced motion too
      // (transitions are disabled there in CSS).
      const visual = document.getElementById('how-visual');
      const stepEls = [...document.querySelectorAll('.how-step')];
      if (stepEls.length) {
        const stepIO = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const i = stepEls.indexOf(entry.target);
              if (visual) visual.dataset.state = String(i);
              stepEls.forEach((s, j) => s.classList.toggle('active', j === i));
            }
          },
          { rootMargin: '-45% 0px -45% 0px' }
        );
        stepEls.forEach((s) => stepIO.observe(s));
      }

      // Signature interaction: the hero diff types tailored lines, one pair at a time.
      // The first pair is server-rendered, so no-JS and reduced-motion get a static diff.
      const pairs = [
        {
          del: 'Responsible for various web development tasks.',
          add: 'Rebuilt the checkout flow in React and TypeScript, halving page-load time.',
          meta: 'react · typescript · performance',
        },
        {
          del: 'Worked with databases and APIs.',
          add: 'Designed the PostgreSQL schema and REST APIs behind three customer-facing products.',
          meta: 'postgresql · rest apis · ownership',
        },
        {
          del: 'Team player with good communication skills.',
          add: 'Mentored two junior engineers and ran weekly architecture reviews.',
          meta: 'mentorship · leadership · communication',
        },
      ];

      const delEl = document.getElementById('diff-del');
      const addEl = document.getElementById('diff-add');
      const metaEl = document.getElementById('diff-meta');

      if (!reduced && delEl && addEl && metaEl) {
        let pair = 0;
        let i = 0;
        const TYPE_MS = 24;
        const HOLD_MS = 2800;

        const type = () => {
          const { add } = pairs[pair];
          if (i <= add.length) {
            addEl.textContent = add.slice(0, i);
            i += 1;
            setTimeout(type, TYPE_MS);
          } else {
            setTimeout(next, HOLD_MS);
          }
        };

        const next = () => {
          pair = (pair + 1) % pairs.length;
          i = 0;
          delEl.textContent = pairs[pair].del;
          metaEl.textContent = pairs[pair].meta;
          type();
        };

        addEl.textContent = '';
        type();
      }
    </script>
  </body>
</html>
