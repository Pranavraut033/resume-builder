---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  // Drafts never get a built route, in dev or prod — index.astro shows them
  // inline with a "draft" tag instead, so there's nothing to preview here.
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · Udaan`} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <p class="font-mono text-xs text-ink-muted">
      {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>
    <h1 class="mt-3 font-display text-4xl tracking-tight text-balance sm:text-5xl">{post.data.title}</h1>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-ink-muted">
          {post.data.tags.map((tag: string) => (
            <li class="rounded-lg border border-line px-2 py-1">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>
