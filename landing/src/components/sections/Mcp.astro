---
import { getBase } from '../../consts';

const base = getBase(import.meta.env.BASE_URL);

const tools = [
  'list_flows',
  'get_prompt',
  'submit',
  'apply_resume_ops',
  'list_profiles',
  'get_profile',
  'list_jobs',
  'get_job_state',
  'preview_profile_edit',
  'apply_profile_edit',
  'fetch_url',
];
---

<!-- ============ MCP server — its own full-width section, own numeral ============ -->
<section id="mcp" data-scroll class="relative border-t border-term-line bg-term px-5 py-24 md:py-32">
  <div class="relative mx-auto max-w-6xl">
    <p
      aria-hidden="true"
      class="ghost-num pointer-events-none absolute -top-4 right-0 -z-10 font-mono text-[7rem] leading-none font-bold tracking-tighter text-term-fg/[0.05] select-none md:text-[11rem]"
    >
      05
    </p>
    <p class="relative reveal flex w-fit items-center rounded-lg bg-term-line/60 px-2.5 py-1 font-mono text-xs font-bold tracking-[0.18em] text-term-accent">
      @@ mcp server @@
    </p>
    <h2 class="reveal mt-5 max-w-2xl font-display text-4xl tracking-tight text-balance text-term-fg sm:text-5xl">
      Or drive it from Claude Desktop.
    </h2>
    <p class="reveal reveal-2 mt-4 max-w-[65ch] leading-relaxed text-term-muted">
      Udaan also runs as an MCP server, so Claude Desktop or any MCP host can parse jobs,
      tailor resumes, and export files on the subscription you already pay for. No separate
      API key. Edits to your base profile go through a diff you approve first, so a model
      driving the app can't quietly rewrite your history.
    </p>

    <div class="reveal reveal-2 mt-10 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-term-line bg-term/60 p-5">
        <p class="font-mono text-xs text-term-muted">available tools</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 font-mono text-xs text-term-fg sm:grid-cols-2">
          {tools.map((t) => <li>{t}()</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-term-line bg-term/60 p-5">
        <p class="font-mono text-xs text-term-muted">claude_desktop_config.json</p>
        <pre class="mt-3 overflow-x-auto font-mono text-xs leading-6 text-term-fg"><code>{`{
  "mcpServers": {
    "resume-builder": {
      "command": "<install>/resources/next/node-bin/node",
      "args": ["<install>/resources/next/mcp/stdio.js"]
    }
  }
}`}</code></pre>
        <p class="mt-3 text-xs text-term-muted">
          The app's Settings page generates this snippet for your own install path.
        </p>
      </div>
    </div>

    <a
      href={`${base}mcp`}
      class="relative reveal mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-term-accent underline underline-offset-4"
    >
      Read the setup docs
    </a>
  </div>
</section>
