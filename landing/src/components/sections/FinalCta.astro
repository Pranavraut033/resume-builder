---
import { REPO, RELEASES } from '../../consts';

// The emphasized clause split into characters for the split-flap entrance.
// Plain server-rendered text sits alongside via the sr-only sibling below,
// so no-JS/no-CSS readers get the real sentence.
const flapText = 'is one udaan away.';
---

<!-- ============ Final CTA — cinematic bookend ============ -->
<section class="border-t border-term-line bg-term">
  <div class="mx-auto max-w-3xl px-5 py-24 text-center md:py-36">
    <p class="reveal mx-auto w-fit font-mono text-xs tracking-[0.2em] text-accent-2">@@ download @@</p>
    <h2 class="reveal mt-5 font-display text-4xl leading-tight tracking-tight text-balance text-term-fg sm:text-5xl md:text-6xl">
      Your next role{' '}
      <em aria-hidden="true" class="text-term-accent">
        {
          [...flapText].map((ch, i) => (
            <span class="flap-char" style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>
          ))
        }
      </em>
      <span class="sr-only">is one udaan away.</span>
    </h2>
    <div class="reveal reveal-2 mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={RELEASES}
        rel="noopener"
        class="btn-block inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3.5 font-semibold text-on-accent"
      >
        Download for free
      </a>
      <a
        href={REPO}
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-lg border border-term-line px-6 py-3.5 font-semibold text-term-fg transition-colors hover:border-term-accent/60"
      >
        Read the source
      </a>
    </div>
    <p class="reveal reveal-3 mt-6 font-mono text-xs text-term-muted">
      Free forever · MIT licensed · no subscription, no sign-up, no cloud storage
    </p>

    <!-- The builds are self-signed, so every OS shows a one-time warning.
         Saying so up front beats a stranger hitting it cold. -->
    <p
      class="reveal reveal-3 mx-auto mt-8 max-w-lg rounded-lg border border-term-line px-4 py-3 text-xs leading-relaxed text-term-muted"
    >
      <span class="font-semibold text-term-fg">First launch:</span> Udaan is open-source and self-signed, not
      paid-publisher signed, so macOS says "cannot be verified" and Windows shows SmartScreen once.
      On macOS right-click the app → <span class="font-semibold">Open</span>; on Windows click
      <span class="font-semibold">More info</span> → <span class="font-semibold">Run anyway</span>.
      <a
        href={`${REPO}#download--install`}
        rel="noopener"
        class="underline underline-offset-4 transition-colors hover:text-term-fg"
      >
        Full install steps
      </a>
    </p>
  </div>
</section>
