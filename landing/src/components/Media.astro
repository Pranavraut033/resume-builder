---
// Drop a file into public/screenshots/ named `${name}.<ext>` and this slot
// fills itself on the next build — no markup change. See src/lib/media.ts
// for the resolution order and src/lib/media.ts's docstring for why.
import { getBase } from '../consts';
import { resolveMedia } from '../lib/media';

interface Props {
  name: string;
  alt: string;
  ratio: string;
  caption?: string;
  class?: string;
}

const { name, alt, ratio, caption, class: extraClass = '' } = Astro.props;
const base = getBase(import.meta.env.BASE_URL);
const resolved = resolveMedia(name);
---

{
  resolved ? (
    <figure class={`overflow-hidden rounded-2xl border border-line ${ratio} w-full ${extraClass}`}>
      {resolved.kind === 'video' ? (
        <video
          src={`${base}${resolved.src}`}
          poster={resolved.poster ? `${base}${resolved.poster}` : undefined}
          class="size-full object-cover"
          data-autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={alt}
        />
      ) : (
        <img
          src={`${base}${resolved.src}`}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="size-full object-cover object-top"
        />
      )}
      {caption && <figcaption class="sr-only">{caption}</figcaption>}
    </figure>
  ) : (
    <div class={`shot-placeholder ${ratio} w-full ${extraClass}`} role="img" aria-label={alt}>
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8.5" cy="9.5" r="1.5" />
        <path d="m3 16 5-5 4 4 3-3 6 6" />
      </svg>
      <p class="font-mono text-xs">
        drop <span class="font-semibold">{name}.png</span> or <span class="font-semibold">{name}.mp4</span> in{' '}
        <span class="font-semibold">public/screenshots/</span>
      </p>
    </div>
  )
}
