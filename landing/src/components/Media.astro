---
// Drop a file into public/screenshots/ named `${name}.<ext>` and this slot
// fills itself on the next build — no markup change. See src/lib/media.ts
// for the resolution order and src/lib/media.ts's docstring for why.
import { getBase } from '../consts';
import { resolveMedia } from '../lib/media';

interface Props {
  name: string;
  alt: string;
  ratio: string;
  caption?: string;
  class?: string;
  /** Ambient demo loops (default) replay forever; narrative clips with a punchline set this false. */
  loop?: boolean;
}

const { name, alt, ratio, caption, class: extraClass = '', loop = true } = Astro.props;
const base = getBase(import.meta.env.BASE_URL);
const resolved = resolveMedia(name);
---

{
  resolved ? (
    <figure class={`relative overflow-hidden rounded-2xl border border-line ${ratio} w-full ${extraClass}`}>
      {resolved.kind === 'video' ? (
        <>
          <video
            src={`${base}${resolved.src}`}
            poster={resolved.poster ? `${base}${resolved.poster}` : undefined}
            class="size-full object-cover"
            muted
            loop={loop}
            playsinline
            preload="metadata"
            aria-label={alt}
          />
          {/* Flashes center-screen once the clip is ~85% scrolled into view
              (not just page-load or 50% — a viewer still reading the copy
              above shouldn't miss the beginning), holds briefly, then fades
              to reveal the now-playing video underneath. Disabled (inert) by
              default; for a non-looping clip, Base.astro re-shows and
              enables this same button once the video ends, so "watch again"
              reuses the identical overlay instead of a second one. See the
              video-flash script in Base.astro for the timing. */}
          <button
            type="button"
            disabled
            aria-label={`Watch ${alt} again`}
            class="media-flash absolute inset-0 flex cursor-pointer items-center justify-center bg-term/55 backdrop-blur-[1px] disabled:cursor-default disabled:pointer-events-none"
          >
            <span class="inline-grid size-16 place-items-center rounded-full bg-accent text-on-accent shadow-block-lg">
              <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5v11l10-5.5Z" /></svg>
            </span>
          </button>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full border border-term-line bg-term/80 px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wide text-term-fg uppercase backdrop-blur-sm"
          >
            <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor"><path d="M1 0.5 7 4 1 7.5Z" /></svg>
            Watch
          </span>
        </>
      ) : (
        <img
          src={`${base}${resolved.src}`}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="size-full object-cover object-top"
        />
      )}
      {caption && <figcaption class="sr-only">{caption}</figcaption>}
    </figure>
  ) : (
    <div class={`shot-placeholder ${ratio} w-full ${extraClass}`} role="img" aria-label={alt}>
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8.5" cy="9.5" r="1.5" />
        <path d="m3 16 5-5 4 4 3-3 6 6" />
      </svg>
      <p class="font-mono text-xs">
        drop <span class="font-semibold">{name}.png</span> or <span class="font-semibold">{name}.mp4 </span> in{' '}
        <span class="font-semibold">public/screenshots/</span>
      </p>
    </div>
  )
}
