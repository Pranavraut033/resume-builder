{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Resume Builder",
  "version": "0.1.0",
  "identifier": "com.resumebuilder.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3008",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Resume Builder",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first, AI-powered resume builder",
    "longDescription": "A privacy-focused desktop application for creating tailored resumes and cover letters using AI. All data stays local.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Resume Builder Self-Signed",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "localhost",
      "frameworks": [],
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "stronghold": null,
    "updater": {
      "pubkey": "/Users/pranavraut/.tauri/resume-builder-update.key.pub",
      "endpoints": [
        "https://github.com/Pranavraut033/resume-builder/releases/latest/download/update.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
