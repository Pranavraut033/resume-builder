{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Udaan",
  "version": "1.4.0",
  "identifier": "com.resumebuilder.dev",
  "build": {
    "frontendDist": "http://127.0.0.1:3008",
    "devUrl": "http://localhost:3008",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare:tauri-server"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "http://127.0.0.1:3009",
        "title": "Udaan",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:3008 http://localhost:3008 http://127.0.0.1:3009 https:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/next/**/*"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first, AI-powered resume builder",
    "longDescription": "A privacy-focused desktop application for creating tailored resumes and cover letters using AI. All data stays local.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "localhost",
      "frameworks": [],
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDM1Mzc3MURFNjU4OTYKUldTV1dPWWRkMU5EYzZCN1JQNktjNjNpb20yUmR5TlpKcW9lR1Jib00rZlgzSEtwZGF4dnBzOE8K",
      "endpoints": [
        "https://github.com/Pranavraut033/resume-builder/releases/latest/download/update.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
