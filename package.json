  "scripts": {
    "predev": "npm run build --prefix packages/llm-core && npm run build --prefix packages/ats-checker",
    "dev": "next dev -p 3008",
    "tauri": "npx -y dotenv-cli -e .env -- tauri",
    "desktop": "tauri dev",
    "prebuild": "npm run build --prefix packages/llm-core && npm run build --prefix packages/ats-checker",
    "build": "next build",
    "prepare:tauri-server": "node scripts/prepareTauriServer.mjs",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
